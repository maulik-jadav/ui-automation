# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

MOCK_APP_PORT=4000
MOCK_APP_BASE_URL=http://localhost:4000

# Required for discover/replay (never pass passwords on the CLI)
CORESERV_USER=csr1
CORESERV_PASS=csr-pass

TENANT=meridian
HOSTILE=1
HOSTILE_SEED=memberbank-v1
SESSION_TIMEOUT_MS=180000
ENABLE_TEST_HARNESS=1
