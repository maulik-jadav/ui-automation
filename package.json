{
  "name": "ui-automation",
  "version": "2.0.0",
  "description": "Computer-use automation system + adversarial CoreServ legacy bank console",
  "type": "module",
  "scripts": {
    "seed": "tsx src/mock-app/seed/seed.ts",
    "start": "tsx src/mock-app/server.ts",
    "mock-app": "tsx src/mock-app/server.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "stability": "tsx src/cli.ts stability",
    "claim": "tsx src/cli.ts claim",
    "resume": "tsx src/cli.ts resume",
    "interventions": "tsx src/cli.ts interventions",
    "approve": "tsx src/cli.ts approve",
    "list-models": "tsx scripts/list-gemini-models.ts",
    "demo-handoff": "tsx scripts/demo-handoff.ts",
    "seed-artifact": "tsx src/cli.ts seed-artifact",
    "dashboard": "npm run dashboard:build && tsx src/dashboard/server/index.ts",
    "dashboard:build": "vite build --config src/dashboard/web/vite.config.ts",
    "dashboard:dev": "concurrently -k -n api,web -c blue,green \"tsx src/dashboard/server/index.ts\" \"vite --config src/dashboard/web/vite.config.ts\"",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:smoke": "tsx --test tests/mock-app/**/*.test.ts",
    "test:dashboard": "tsx --test tests/dashboard/**/*.test.ts",
    "build": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "playwright": "^1.50.1",
    "uuid": "^11.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.2"
  }
}
